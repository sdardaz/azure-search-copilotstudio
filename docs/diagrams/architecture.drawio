nt-size:8.5px;color:#605E5C&#x27;&gt;Teams / web / M365&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="2174" y="356" width="70" height="62" as="geometry"/></mxCell><mxCell id="n39" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2120.0" y="338.0" width="20" height="20" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Schéma de l&#x27;index&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; (clé) · &lt;b&gt;parent_id&lt;/b&gt; · &lt;b&gt;content&lt;/b&gt; (searchable)&lt;br&gt;&lt;b&gt;sourcepage&lt;/b&gt; · &lt;b&gt;sourcefile&lt;/b&gt; · &lt;b&gt;storageUrl&lt;/b&gt; → citations&lt;br&gt;&lt;b&gt;embedding3&lt;/b&gt; : HNSW / cosinus · &lt;b&gt;category&lt;/b&gt; (filtre)&lt;br&gt;&lt;b&gt;images&lt;/b&gt;[] : embedding, url, description, bbox&lt;br&gt;&lt;b&gt;oids&lt;/b&gt; / &lt;b&gt;groups&lt;/b&gt; → filtrage par droits (option)&lt;br&gt;Config. sémantique &lt;b&gt;default&lt;/b&gt; (titre = sourcepage)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Segoe UI;fontSize=8;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1470" y="462" width="248" height="118" as="geometry"/></mxCell><mxCell id="n41" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1470" y="620" width="248" height="96" as="geometry"/></mxCell><mxCell id="n42" value="LOGO" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#B3B3B3;dashed=1;dashPattern=3 3;fontFamily=Segoe UI;fontSize=6;fontColor