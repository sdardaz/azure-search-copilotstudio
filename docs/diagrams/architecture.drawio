"edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#605E5C;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Segoe UI;fontSize=9.5;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n58" target="n72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e92" value="Vectorisation&lt;br&gt;de la requête" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0078D4;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Segoe UI;fontSize=9.5;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;dashed=1;dashPattern=5 4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="n72" target="n28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="798"/><mxPoint x="1420" y="430"/></Array></mxGeometry></mxCell><mxCell id="n93" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="40.0" y="1032" width="720.0" height="116" as="geometry"/></mxCell><mxCell id="n94" value="&lt;b&gt;Identité &amp;amp; sécurité&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10.5;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="52.0" y="1039" width="696.0" height="20" as="geometry"/></mxCell><mxCell id="n95" value="•&amp;nbsp; &lt;b&gt;Identités managées&lt;/b&gt; de bout en bout : Search → Storage / Foundry / Vision&amp;nbsp;·&amp;nbsp; Functions → Storage / Search / Foundry / Document Intelligence&amp;nbsp;·&amp;nbsp; Logic App → Graph / Storage / Search&lt;br&gt;•&amp;nbsp; &lt;b&gt;Aucune clé stockée&lt;/b&gt; : &lt;i&gt;disableLocalAuth&lt;/i&gt; sur Azure AI Search et Document Intelligence, &lt;i&gt;allowSharedKeyAccess = false&lt;/i&gt; sur le compte de stockage&lt;br&gt;•&amp;nbsp; les 3 endpoints de compétences sont protégés par &lt;b&gt;Microsoft Entra ID&lt;/b&gt; (authentification requise, sinon HTTP 401)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="52.0" y="1060" width="696.0" height="82" as="geometry"/></mxCell><mxCell id="n96" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="780.0" y="1032" width="720.0" height="116" as="geometry"/></mxCell><mxCell id="n97" value="&lt;b&gt;Réseau&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10.5;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="792.0" y="1039" width="696.0" height="20" as="geometry"/></mxCell><mxCell id="n98" value="•&amp;nbsp; &lt;b&gt;Private Endpoints&lt;/b&gt; optionnels : Blob Storage, Azure AI Search, comptes Cognitive Services / Foundry&lt;br&gt;•&amp;nbsp; zones &lt;b&gt;Azure Private DNS&lt;/b&gt; associées&amp;nbsp;·&amp;nbsp; &lt;i&gt;publicNetworkAccess&lt;/i&gt; peut être positionné à &lt;b&gt;Disabled&lt;/b&gt;&lt;br&gt;•&amp;nbsp; accès d&#x27;exploitation par &lt;b&gt;passerelle VPN point-à-site&lt;/b&gt; + résolveur DNS privé (option)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="792.0" y="1060" width="696.0" height="82" as="geometry"/></mxCell><mxCell id="n99" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1520.0" y="1032" width="720.0" height="116" as="geometry"/></mxCell><mxCell id="n100" value="&lt;b&gt;Observabilité &amp;amp; coûts&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10.5;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="1532.0" y="1039" width="696.0" height="20" as="geometry"/></mxCell><mxCell id="n101" value="•&amp;nbsp; &lt;b&gt;Application Insights&lt;/b&gt; + &lt;b&gt;Log Analytics&lt;/b&gt; : Functions, Logic App, diagnostics Azure AI Search&lt;br&gt;•&amp;nbsp; historique d&#x27;exécution de l&#x27;indexeur et de la Logic App consultable dans le portail Azure&lt;br&gt;•&amp;nbsp; &lt;b&gt;coût récurrent principal : Azure AI Search&lt;/b&gt; (facturé à l&#x27;heure, même index vide) → dimensionner le SKU en premier" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1532.0" y="1060" width="696.0" height="82" as="geometry"/></mxCell><mxCell id="n102" value="Flux de données — étape par étape, et justification de chaque choix" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12.5;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="40" y="1178" width="1400" height="24" as="geometry"/></mxCell><mxCell id="n103" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1212" width="22" height="22" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;SharePoint dans Microsoft 365 — source&lt;/b&gt; — Les documents restent gérés là où le métier les gère déjà : droits, cycle de vie et versioning ne sont pas dupliqués. Aucune migration de contenu n&#x27;est nécessaire." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1210" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n105" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1212" width="22" height="22" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Azure Logic Apps — synchronisation incrémentale&lt;/b&gt; — Déclencheur récurrent + &lt;b&gt;requête delta Microsoft Graph&lt;/b&gt; : seuls les fichiers créés ou modifiés sont traités. Authentification par &lt;b&gt;identité managée&lt;/b&gt; (permission Graph &lt;b&gt;Sites.Selected&lt;/b&gt;) — pas de connecteur OAuth à réautoriser périodiquement. Provisionnée à chaque &lt;i&gt;azd up&lt;/i&gt;, livrée à l&#x27;état &lt;b&gt;Disabled&lt;/b&gt; tant que SHAREPOINT_HOSTNAME et SHAREPOINT_SITE_PATH ne sont pas renseignés." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1210" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n107" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1278" width="22" height="22" as="geometry"/></mxCell><mxCell id="n108" value="&lt;b&gt;Azure Blob Storage — zone d&#x27;atterrissage&lt;/b&gt; — Point d&#x27;entrée unique et uniforme quelle que soit l&#x27;origine (SharePoint, CLI locale, dépôt manuel). Le compte est un &lt;b&gt;Azure Data Lake Storage Gen2&lt;/b&gt; lorsque le filtrage par droits est activé. Le &lt;b&gt;soft-delete natif&lt;/b&gt; sert de politique de détection de suppression pour l&#x27;indexeur." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1276" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n109" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1278" width="22" height="22" as="geometry"/></mxCell><mxCell id="n110" value="&lt;b&gt;Indexeur Azure AI Search — orchestrateur managé&lt;/b&gt; — C&#x27;est le service Microsoft qui porte la planification, le suivi des changements, les relances et le traitement par lots. &lt;b&gt;Aucun orchestrateur maison à héberger, patcher ni superviser.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1276" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n111" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1344" width="22" height="22" as="geometry"/></mxCell><mxCell id="n112" value="&lt;b&gt;Compétence « Document Extractor »&lt;/b&gt; — Un seul composant connaît tous les formats : PDF, DOCX, PPTX, XLSX, PNG / JPG, HTML, JSON, CSV, TXT / MD. Les tableaux sont convertis en HTML pour préserver leur structure ; les figures sont localisées par coordonnées. Extrait aussi les &lt;b&gt;ACL&lt;/b&gt; lorsque ADLS Gen2 est activé." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1342" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n113" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1344" width="22" height="22" as="geometry"/></mxCell><mxCell id="n114" value="&lt;b&gt;Compétence « Figure Processor »&lt;/b&gt; — Graphiques, schémas et photos deviennent du &lt;b&gt;texte recherchable&lt;/b&gt; (description générée par un modèle vision) et, en option, des &lt;b&gt;vecteurs d&#x27;image&lt;/b&gt;. Sans cette étape, tout le contenu visuel serait invisible pour la recherche." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1342" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n115" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="22" height="22" as="geometry"/></mxCell><mxCell id="n116" value="&lt;b&gt;Compétence « Shaper » (intégrée Microsoft)&lt;/b&gt; — Compétence native, sans code : consolide pages, figures et métadonnées en un objet unique. Réduit d&#x27;autant la surface de code personnalisé à maintenir." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1408" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n117" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1410" width="22" height="22" as="geometry"/></mxCell><mxCell id="n118" value="&lt;b&gt;Compétence « Text Processor »&lt;/b&gt; — Fusionne les descriptions de figures dans le texte, découpe en &lt;b&gt;chunks&lt;/b&gt; respectant les frontières de phrases, puis calcule les &lt;b&gt;embeddings&lt;/b&gt; (text-embedding-3-large, 3072 dimensions). Le découpage conditionne directement la pertinence ; les vecteurs sont calculés une seule fois, à l&#x27;ingestion." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1408" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n119" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1476" width="22" height="22" as="geometry"/></mxCell><mxCell id="n120" value="&lt;b&gt;Index Azure AI Search — projection par chunk&lt;/b&gt; — &lt;b&gt;1 document d&#x27;index = 1 chunk&lt;/b&gt; (&lt;i&gt;index projection&lt;/i&gt;, documents parents non indexés). C&#x27;est ce qui permet des réponses précises et des citations au niveau du passage plutôt que du fichier entier. Recherche &lt;b&gt;hybride&lt;/b&gt; (mots-clés + vecteurs) et &lt;b&gt;ranker sémantique&lt;/b&gt; activables." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1474" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n121" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1476" width="22" height="22" as="geometry"/></mxCell><mxCell id="n122" value="&lt;b&gt;Microsoft Copilot Studio — connecteur natif&lt;/b&gt; — Ajout via &lt;b&gt;Connaissances → Azure AI Search&lt;/b&gt; avec authentification &lt;b&gt;Microsoft Entra ID intégrée&lt;/b&gt; (et non par clé API). Copilot Studio porte l&#x27;orchestration, la génération de la réponse et les citations : &lt;b&gt;aucun backend de conversation à développer, héberger, patcher ni sécuriser.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1474" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n123" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1542" width="22" height="22" as="geometry"/></mxCell><mxCell id="n124" value="&lt;b&gt;Utilisateur métier&lt;/b&gt; — Pose sa question dans Teams, sur le web ou dans Microsoft 365, et reçoit une réponse &lt;b&gt;ancrée&lt;/b&gt; dans les documents de l&#x27;organisation, accompagnée des liens de citation (champ &lt;b&gt;storageUrl&lt;/b&gt; / &lt;b&gt;metadata_storage_path&lt;/b&gt;)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="70" y="1540" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n125" value="—" style="ellipse;whiteSpace=wrap;html=1;fillColor=#605E5C;strokeColor=none;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="1542" width="22" height="22" as="geometry"/></mxCell><mxCell id="n126" value="&lt;b&gt;Chemin alternatif : ingestion locale (CLI)&lt;/b&gt; — &lt;b&gt;prepdocs.py&lt;/b&gt; exécute la même bibliothèque de traitement (&lt;i&gt;prepdocslib&lt;/i&gt;) depuis un poste ou un agent CI et écrit directement dans l&#x27;index. Utile pour une maquette, une reprise ponctuelle ou un corpus figé, sans provisionner ni les Functions ni la Logic App (&lt;b&gt;USE_CLOUD_INGESTION=false&lt;/b&gt; ; l&#x27;ingestion cloud est active par défaut)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="1190" y="1540" width="1030" height="60" as="geometry"/></mxCell><mxCell id="n127" value="Légende" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10.5;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="40" y="1622" width="200" height="20" as="geometry"/></mxCell><mxCell id="n128" value="" style="rounded=1;arcSize=14;html=1;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="40" y="1648" width="22" height="16" as="geometry"/></mxCell><mxCell id="n129" value="Service Azure managé" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="68" y="1646" width="112.0" height="20" as="geometry"/></mxCell><mxCell id="n130" value="" style="rounded=1;arcSize=14;html=1;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#107C41;" vertex="1" parent="1"><mxGeometry x="204.0" y="1648" width="22" height="16" as="geometry"/></mxCell><mxCell id="n131" value="Service Microsoft 365 / Power Platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="232.0" y="1646" width="200.20000000000002" height="20" as="geometry"/></mxCell><mxCell id="n132" value="" style="rounded=1;arcSize=14;html=1;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="456.20000000000005" y="1648" width="22" height="16" as="geometry"/></mxCell><mxCell id="n133" value="Acteur ou source hors Azure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="484.20000000000005" y="1646" width="146.3" height="20" as="geometry"/></mxCell><mxCell id="n134" value="" style="rounded=1;arcSize=14;html=1;strokeWidth=1.4;fillColor=#F3F2F1;strokeColor=#B3B3B3;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="654.5" y="1648" width="22" height="16" as="geometry"/></mxCell><mxCell id="n135" value="Emplacement réservé au logo officiel — à remplacer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=0;fontColor=#243A5E;" vertex="1" parent="1"><mxGeometry x="682.5" y="1646" width="259.0" height="20" as="geometry"/></mxCell><mxCell id="n136" value="Trait plein bleu = flux de données principal&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;trait plein violet = exécution du skillset par l&#x27;indexeur&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;trait pointillé = appel de service ou chemin optionnel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.5;fontStyle=2;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="40" y="1672" width="1500" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>